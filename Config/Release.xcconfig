// Secrets.xcconfig から環境変数を読み込む
#include "Secrets.xcconfig"

// ビルド設定
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) RELEASE

// Info.plistから参照するように環境変数を埋め込む
SUPABASE_PROJECT_REF = $(SUPABASE_PROJECT_REF)
SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
// AdMob (Release は AdMob ダッシュボードで作成した本番 ID)
GAD_APPLICATION_IDENTIFIER = ca-app-pub-3597606093191733~9695965145
REWARDED_AD_UNIT_ID = ca-app-pub-3597606093191733/1793424391
